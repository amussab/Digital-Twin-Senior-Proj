   "procedure": "if first output or alpha >= 1: r = r_raw; else prior = max(r_prev - 1, 0); r = exp(alpha*ln(1+r_raw) + (1-alpha)*ln(1+prior)) - 1; r_prev = r (UNscaled); compute in float64"
  },
  "rul_scale": {
