<svg class="pump-twin-svg"
     viewBox="0 0 720 260"
     width="100%"
     role="img"
     aria-label="OH-2 pump showing two bearing locations">

    <defs>
        <linearGradient id="metal" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#2b5870" />
            <stop offset="100%" stop-color="#102b3c" />
        </linearGradient>

        <radialGradient id="pumpBody">
            <stop offset="0%" stop-color="#184b62" />
            <stop offset="100%" stop-color="#092333" />
        </radialGradient>
    </defs>

    <!-- Motor -->
    <polygon points="40,100 70,75 210,75 180,100"
             fill="#32677d" />

    <rect x="40" y="100"
          width="140" height="85"
          rx="8"
          fill="url(#metal)"
          stroke="#4ca3bf" />

    <polygon points="180,100 210,75 210,160 180,185"
             fill="#14384a"
             stroke="#4ca3bf" />

    <text x="110" y="210"
          text-anchor="middle"
          fill="#8fb5c8">
        Motor
    </text>

    <!-- Coupling -->
    <rect x="210" y="125"
          width="70" height="16"
          fill="#6ea6b8" />

    <rect x="225" y="112"
          width="26" height="42"
          rx="5"
          fill="#26708c"
          stroke="#67e8f9" />

    <!-- Bearing housing -->
    <polygon points="280,103 305,82 450,82 425,103"
             fill="#35677b" />

    <rect x="280" y="103"
          width="145" height="80"
          rx="8"
          fill="url(#metal)"
          stroke="#4ca3bf" />

    <polygon points="425,103 450,82 450,162 425,183"
             fill="#123547"
             stroke="#4ca3bf" />

    <!-- Shaft -->
    <rect x="265" y="127"
          width="220" height="12"
          fill="#86bac9" />

    <!-- Bearing 1 -->
    <circle cx="320" cy="133" r="24"
            fill="#071b29"
            stroke="#22d3ee"
            stroke-width="5" />

    <circle cx="320" cy="133" r="8"
            fill="#22d3ee" />

    <line x1="320" y1="105"
          x2="320" y2="45"
          stroke="#22d3ee" />

    <text x="320" y="32"
          text-anchor="middle"
          fill="#67e8f9">
        Bearing 1
    </text>

    <!-- Bearing 2 -->
    <circle cx="390" cy="133" r="24"
            fill="#071b29"
            stroke="#fb923c"
            stroke-width="5" />

    <circle cx="390" cy="133" r="8"
            fill="#fb923c" />

    <line x1="390" y1="105"
          x2="390" y2="45"
          stroke="#fb923c" />

    <text x="390" y="32"
          text-anchor="middle"
          fill="#fdba74">
        Bearing 2
    </text>

    <!-- Pump casing -->
    <circle cx="545" cy="130" r="75"
            fill="url(#pumpBody)"
            stroke="#38b9d6"
            stroke-width="3" />

    <circle cx="545" cy="130" r="35"
            fill="#071b29"
            stroke="#22d3ee"
            stroke-width="3" />

    <path d="M545 55 C640 55 650 130 610 170"
          fill="none"
          stroke="#2c7189"
          stroke-width="24" />

    <!-- Suction and discharge -->
    <rect x="610" y="118"
          width="90" height="28"
          fill="#245b70"
          stroke="#38b9d6" />

    <rect x="530" y="25"
          width="30" height="45"
          fill="#245b70"
          stroke="#38b9d6" />

    <text x="555" y="230"
          text-anchor="middle"
          fill="#8fb5c8">
        OH-2 Centrifugal Pump
    </text>
</svg>