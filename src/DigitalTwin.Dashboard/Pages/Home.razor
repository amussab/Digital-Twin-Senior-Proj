@page "/"
@implements IAsyncDisposable
@inject IDashboardDataSource DataSource

<PageTitle>Digital Twin Dashboard</PageTitle>

<header class="topbar">
    <div>
        <p class="eyebrow">OH-2 PUMP MONITORING</p>
        <h1>Machine Health Overview</h1>
    </div>

    <div class="header-status">
        <span class="connection-dot @(Snapshot?.IsConnected == true ? "online" : "offline")"></span>
        <span>@(Snapshot?.IsConnected == true ? "Live" : "Disconnected")</span>
        <span class="divider"></span>
        <span>@(Snapshot?.MachineId ?? "Waiting...")</span>
        @if (Snapshot?.Live is { } lv)
        {
            <span class="divider"></span>
            <span class="tag @(lv.Provenance.Contains("SIMULATION") ? "" : "success")">@(lv.Provenance.Contains("SIMULATION") ? "Source: simulated replay" : "Source: Node (live)")</span>
            <span class="tag @(lv.Provenance.Contains("REPLAY") ? "" : "success")">@lv.Provenance</span>
        }
    </div>
</header>

@if (Snapshot is null)
{
    <section class="loading-state">
        Waiting for the first monitoring window…
    </section>
}
else
{
    <div class="dashboard-workspace">

        <section class="dashboard-main">

            <LivePanel Live="Snapshot.Live" />

            <section class="metrics-grid">
                <MetricCard Label="Health Index"
                            Value="@($"{Snapshot.HealthIndexPercent:F0}%")"
                            Detail="Overall estimated condition"
                            AccentClass="accent-cyan" />

                <MetricCard Label="AI Remaining Life"
                            Value="@(Snapshot.AiRulHours < 0 ? "n/a" : $"{Snapshot.AiRulHours:F0} h")"
                            Detail="@(Snapshot.Live is null ? "N-HiTS estimate" : Snapshot.AiRulHours >= 0 ? (Snapshot.Live.RulSource is not null ? "Remaining life estimate" : "RUL head, simulated hours") : Snapshot.Live.RulSource is not null ? "n/a (healthy or warming up)" : "n/a: no RUL model validated on live node windows")"
                            AccentClass="accent-violet" />

                <MetricCard Label="Fault State"
                            Value="@Snapshot.FaultClass"
                            Detail="@($"{Snapshot.FaultConfidencePercent:F1}% confidence")"
                            AccentClass="@(Snapshot.FaultClass == "Healthy"
                                                ? "accent-green"
                                                : "accent-orange")" />

                <MetricCard Label="Health Stage"
                            Value="@(Snapshot.HealthStage is int hs ? $"{hs} / 6" : "n/a")"
                            Detail="1 = healthy, 6 = failure imminent"
                            AccentClass="@(Snapshot.HealthStage >= 4 ? "accent-orange" : "accent-green")" />

                <MetricCard Label="Shaft Speed"
                            Value="@($"{Snapshot.Rpm:F0} RPM")"
                            Detail="20-revolution window"
                            AccentClass="accent-blue" />
            </section>

            <TrendChart Title="AI RUL Trend"
                        CurrentValue="@(Snapshot.AiRulHours < 0 ? "n/a" : $"{Snapshot.AiRulHours:F0} hours")"
                        Values="RulHistory" />

            <section class="lower-grid">
                <article class="system-panel">
                    <div class="panel-heading">
                        <span>Physics Comparison</span>
                        <span class="tag">Optional input</span>
                    </div>

                    @if (Snapshot.Live is not null)
                    {
                        @if (Snapshot.PhysicsRulHours is double lp && Snapshot.AiRulHours >= 0)
                        {
                            <div class="comparison-row"><span>Physics RUL (feature twin)</span><strong>@lp.ToString("F1") h</strong></div>
                            <div class="comparison-row"><span>AI RUL</span><strong>@Snapshot.AiRulHours.ToString("F1") h</strong></div>
                            <div class="comparison-row"><span>Residual |phys-AI| / AI</span><strong>@Snapshot.RulResidualPercent?.ToString("F0")%</strong></div>
                            <div class="comparison-row"><span>Provenance</span><strong>@Snapshot.Live.Provenance</strong></div>
                        }
                        else
                        {
                            <div class="comparison-row"><span>Physics RUL / AI RUL</span><strong>n/a (@(Snapshot.Live.Provenance.Contains("SIMULATION") ? "shown for a bearing classified faulted at stage 2 or later" : (Snapshot.Live.RulSource is not null ? "shown for a bearing classified faulted" : "live node: no RUL model validated, twin reads features only")))</strong></div>
                        }
                    }
                    else if (Snapshot.PhysicsRulHours is double physicsRul)
                    {
                        <div class="comparison-row">
                            <span>Physics RUL</span>
                            <strong>@physicsRul.ToString("F0") h</strong>
                        </div>

                        <div class="comparison-row">
                            <span>AI RUL</span>
                            <strong>@Snapshot.AiRulHours.ToString("F0") h</strong>
                        </div>

                        <div class="comparison-row">
                            <span>Residual</span>
                            <strong>@Snapshot.RulResidualPercent?.ToString("F1")%</strong>
                        </div>
                    }
                </article>

                <article class="system-panel">
                    <div class="panel-heading">
                        <span>System Diagnostics</span>
                        <span class="tag success">Nominal</span>
                    </div>

                    <div class="comparison-row">
                        <span>Processing latency</span>
                        <strong>@Snapshot.ProcessingLatencyMs.ToString("F0") ms</strong>
                    </div>

                    <div class="comparison-row">
                        <span>Last data</span>
                        <strong>@Snapshot.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")</strong>
                    </div>

                    <div class="comparison-row">
                        <span>Contract version</span>
                        <strong>@($"v{Snapshot.SchemaVersion}")</strong>
                    </div>
                </article>
            </section>

        </section>

        <aside class="system-panel inspection-panel">
            <div class="panel-heading">
                <span>3D Pump Inspection</span>
                <strong>@($"{Snapshot.HealthIndexPercent:F0}% health")</strong>
            </div>

            <PumpViewer3D Bearing1Fault="@Snapshot.Bearing1Fault"
                          Bearing2Fault="@Snapshot.Bearing2Fault"
                          FaultConfidencePercent="@Snapshot.FaultConfidencePercent" />

            <div class="health-bar">
                <span style="width: @($"{Snapshot.HealthIndexPercent}%")"></span>
            </div>

            <div class="inspection-details">
                <div class="comparison-row">
                    <span>Machine</span>
                    <strong>@Snapshot.MachineId</strong>
                </div>

                <div class="comparison-row">
                    <span>Detected condition</span>
                    <strong>@Snapshot.FaultClass</strong>
                </div>

                <div class="comparison-row">
                    <span>Health stage</span>
                    <strong>@(Snapshot.HealthStage is int st ? $"{st} / 6" : "n/a")</strong>
                </div>

                <div class="comparison-row">
                    <span>Confidence</span>
                    <strong>@Snapshot.FaultConfidencePercent.ToString("F1")%</strong>
                </div>
            </div>
        </aside>

    </div>
}

@code {
    private readonly CancellationTokenSource _cancellation = new();
    private readonly List<double> _rulHistory = [];

    private DashboardSnapshot? Snapshot { get; set; }
    private IReadOnlyList<double> RulHistory => _rulHistory;

    protected override void OnInitialized()
    {
        _ = ConsumeSnapshotsAsync();
    }

    private async Task ConsumeSnapshotsAsync()
    {
        try
        {
            await foreach (
                var snapshot in DataSource.StreamAsync(_cancellation.Token))
            {
                Snapshot = snapshot;
                if (snapshot.AiRulHours >= 0)      // -1 = n/a (live node): never plot it
                {
                    _rulHistory.Add(snapshot.AiRulHours);
                }

                if (_rulHistory.Count > 40)
                {
                    _rulHistory.RemoveAt(0);
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public ValueTask DisposeAsync()
    {
        _cancellation.Cancel();
        _cancellation.Dispose();

        return ValueTask.CompletedTask;
    }
}