# ---------------------------------------------------------------------------
# Python / AI-test
# ---------------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Generated by the AI-test app. All of it is reproducible from a fixed seed
# with `python app.py all`, and the checkpoints are large, so none of it is
# tracked. The spec-check reports under AI-test/reports/ ARE tracked on
# purpose -- they are the evidence record of what was run and what it scored.
AI-test/data/
AI-test/artifacts/
AI-test/lightning_logs/
lightning_logs/
*.ckpt
*.onnx
*.pt
*.pth

# ---------------------------------------------------------------------------
# .NET (dashboard / digital-twin backend)
# ---------------------------------------------------------------------------
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
artifacts/
publish/
*.nupkg

# ---------------------------------------------------------------------------
# Embedded toolchains (STM32 / ESP32 side, if it lands in this repo)
# ---------------------------------------------------------------------------
build/
cmake-build-*/
.pio/
sdkconfig.old

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Office lock files -- these appear whenever a .docx/.xlsx/.pptx is open and
# should never be committed.
~$*
*.tmp
